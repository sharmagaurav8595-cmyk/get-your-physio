API_PORT=8787

# Optional SMTP settings. Without these, OTPs are printed by the local API
# and returned to the browser only while NODE_ENV is not production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=GetYourPhysio.in <youraccount@gmail.com>

# Gmail local-testing example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=GetYourPhysio.in <youraccount@gmail.com>

# Resend production example:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=GetYourPhysio.in <otp@your-verified-domain.com>
